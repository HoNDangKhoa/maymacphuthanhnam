# =============================================================================
# LOCAL (docker compose up -d)
# =============================================================================
DATABASE_URL="postgresql://ptn:ptn@localhost:5433/phuthanhnam?schema=public"

# NextAuth
AUTH_SECRET="replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Admin seed
ADMIN_EMAIL="admin@phuthanhnam.vn"
ADMIN_PASSWORD="admin123"

# -----------------------------------------------------------------------------
# Upstash Redis (https://console.upstash.com) — cache + rate limit
# Trên Vercel: Storage → Create → Upstash Redis → Connect
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
REDIS_KEY_PREFIX="ptn"
REDIS_CACHE_TTL="300"

# -----------------------------------------------------------------------------
# Vercel Blob (file upload trên production)
# vercel → Storage → Blob → Connect Project
# -----------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# =============================================================================
# VERCEL PRODUCTION (set trong Project → Settings → Environment Variables)
# =============================================================================
# DATABASE_URL=postgresql://...neon.tech/neondb?sslmode=require
# AUTH_SECRET=...
# AUTH_URL=https://your-domain.vercel.app
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# ADMIN_EMAIL=...
# ADMIN_PASSWORD=...   (chỉ dùng khi seed, không cần runtime)
